generator client {
  provider = "prisma-client-js"
  output   = "../src/db/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  createdAt   DateTime     @default(now())
  alerts      Alert[]
  walletItems WalletItem[]
}

model Stock {
  symbol           String       @id
  name             String
  price            Float
  openPrice        Float
  changePercentDay Float
  dayHigh          Float
  dayLow           Float
  dividendYield    Float
  priceToBook      Float?
  peRatio          Float?
  lastChange       DateTime?
  alerts           Alert[]
  walletItems      WalletItem[]
}

model WalletItem {
  id             String   @id @default(uuid())
  quantity       Float    @default(0)
  referencePrice Float
  createdAt      DateTime @default(now())
  userId         String
  stockSymbol    String
  stock          Stock    @relation(fields: [stockSymbol], references: [symbol])
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId, stockSymbol])
}

model Alert {
  id              String          @id @default(uuid())
  status          AlertStatus     @default(ativo)
  targetValue     Float
  targetValueType TargetValueType
  targetCondition TargetCondition
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?       @updatedAt
  userId          String
  stockSymbol     String
  targetAsset     Stock           @relation(fields: [stockSymbol], references: [symbol])
  user            User            @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([stockSymbol])
}

enum AlertStatus {
  ativo
  disparado
  pausado
}

enum TargetValueType {
  value
  variationDay
}

enum TargetCondition {
  above
  below
}
